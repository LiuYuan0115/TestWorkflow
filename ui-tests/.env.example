# ============================================================
# zhisuanpai-ui-tests 环境变量示例
# 使用方式：复制本文件为 .env，并按需修改
#   cp .env.example .env
# ============================================================

# ── Midscene AI 模型配置（必填） ─────────────────────────────
# 支持任何兼容 OpenAI API 协议的模型（GPT-4o、Claude、DeepSeek、通义千问等）

# AI 模型 API 基础地址
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1

# AI 模型 API Key（不要提交到 git）
MIDSCENE_MODEL_API_KEY=sk-your-api-key-here

# 使用的模型名称（推荐具备视觉能力的多模态模型）
MIDSCENE_MODEL_NAME=gpt-4o

# 模型家族（可选，部分模型如 qwen3.5 需要显式指定，便于 Midscene 选择适配的 prompt 模板）
# MIDSCENE_MODEL_FAMILY=openai

# 是否启用模型推理模式（可选，默认 false；某些 reasoning 模型可设为 "true"）
# MIDSCENE_MODEL_REASONING_ENABLED=false

# ── Midscene 缓存配置（可选） ────────────────────────────────
# 启用 AI 响应缓存，减少重复 AI 调用（开发/调试阶段推荐开启）
MIDSCENE_CACHE_ENABLED=true

# 缓存目录（默认 .midscene_cache）
# MIDSCENE_CACHE_DIR=.midscene_cache

# 缓存有效期（秒，推荐 90 天 = 7776000；页面结构变更后手动清理缓存即可）
MIDSCENE_CACHE_TTL=7776000

# ── 智算派应用配置（可选） ────────────────────────────────────
# 前端地址，默认 http://127.0.0.1:1520
# BASE_URL=http://127.0.0.1:1520

# 登录页地址，默认 ${BASE_URL}/login
# LOGIN_URL=http://127.0.0.1:1520/login

# ── 登录测试账号（可选） ────────────────────────────────────
# TEST_USERNAME=your_username
# TEST_PASSWORD=your_password

# ── 运行模式（可选） ────────────────────────────────────────
# HEADLESS=false
# DEBUG=false
